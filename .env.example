POSTGRES_USER=copilotaudit
POSTGRES_PASSWORD=copilotaudit
POSTGRES_DB=copilotaudit
DATABASE_URL=postgresql://copilotaudit:copilotaudit@localhost:5432/copilotaudit

MLFLOW_TRACKING_URI=http://localhost:5000

# Audit log retention, EU AI Act Article 12 minimum is 6 months (in days)
AUDIT_LOG_RETENTION_DAYS=180

# Only needed when running the api service inside Docker (see docker-compose.yml),
# where Ollama stays on the host and localhost inside the container means the
# container itself. Leave unset for host-based (non-Docker) runs.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
